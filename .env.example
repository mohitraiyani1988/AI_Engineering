# Copy this file to .env and add only the providers you want to test.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Comma-separated frontend origins allowed to call the FastAPI backend.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Model names are configuration because provider availability changes over time.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-small-latest
